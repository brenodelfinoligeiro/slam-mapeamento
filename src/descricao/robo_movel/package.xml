<?xml version="1.0"?>
<package format="3">
  <name>robo_movel</name>
  <version>0.0.0</version>
  <description>Pacote ROS 2 acadêmico para um robô móvel diferencial com odometria, MPU-6050 e LiDAR C1.</description>
  <maintainer email="a_definir@example.com">lamggm</maintainer>
  <license>A definir</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
