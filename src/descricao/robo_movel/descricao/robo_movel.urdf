<?xml version='1.0' encoding='utf-8'?>
<robot name="robo_movel">
  <!--Derivado do CAD R05; metros; datums de montagem não substituem calibração física. Sem inércias inventadas.-->
  <material name="estrutura">
    <color rgba=".22 .34 .44 1" />
  </material>
  <material name="metal">
    <color rgba=".64 .68 .72 1" />
  </material>
  <material name="motores">
    <color rgba=".88 .68 .12 1" />
  </material>
  <material name="placas">
    <color rgba=".14 .43 .25 1" />
  </material>
  <material name="reserva">
    <color rgba=".60 .35 .70 .35" />
  </material>
  <material name="pilhas">
    <color rgba=".68 .41 .15 1" />
  </material>
