Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 35; 38; 45
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Chao
    Enabled: true
    Cell Size: 0.5
    Plane Cell Count: 30
  - Class: rviz_default_plugins/Map
    Name: Mapa estimado pelo SLAM
    Enabled: true
    Alpha: 0.7
    Topic:
      Value: /map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/RobotModel
    Name: Robo movel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/LaserScan
    Name: Laser simulado
    Enabled: true
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Size (m): 0.015
    Style: Points
    Decay Time: 0
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: Pose SLAM
    Enabled: true
    Topic:
      Value: /pose
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Path
    Name: Estimativa odo e IMU
    Enabled: true
    Topic:
      Value: /trajetoria/estimada
      Reliability Policy: Reliable
    Color: 70; 240; 110
    Line Width: 0.01
  - Class: rviz_default_plugins/Path
    Name: Somente rodas
    Enabled: true
    Topic:
      Value: /trajetoria/rodas
      Reliability Policy: Reliable
    Color: 240; 130; 40
    Line Width: 0.008
  - Class: rviz_default_plugins/Path
    Name: Referencia virtual nao fundida
    Enabled: true
    Topic:
      Value: /trajetoria/referencia
      Reliability Policy: Reliable
    Color: 70; 150; 255
    Line Width: 0.006
  - Class: rviz_default_plugins/TF
    Name: Referenciais
    Enabled: false
  - Class: rviz_default_plugins/Map
    Name: Costmap global
    Enabled: true
    Alpha: 0.45
    Color Scheme: costmap
    Topic:
      Value: /global_costmap/costmap
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Use Timestamp: false
  - Class: rviz_default_plugins/Map
    Name: Costmap local
    Enabled: true
    Alpha: 0.35
    Color Scheme: costmap
    Topic:
      Value: /local_costmap/costmap
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Use Timestamp: false
  - Class: rviz_default_plugins/Path
    Name: Plano global Nav2
    Enabled: true
    Color: 255; 215; 0
    Line Style: Lines
    Line Width: 0.025
    Topic:
      Value: /plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 10
  - Class: rviz_default_plugins/Path
    Name: Plano transformado RPP
    Enabled: true
    Color: 0; 255; 255
    Line Style: Lines
    Line Width: 0.018
    Topic:
      Value: /received_global_plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 10
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: nav2_rviz_plugins/GoalTool
    Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9.0
      Pitch: 1.3
      Yaw: 0.0
      Focal Point:
        X: 0.5
        Y: 0.5
        Z: 0.0
Window Geometry:
  Width: 1280
  Height: 900
